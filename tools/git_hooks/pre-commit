#!/usr/bin/env bash
# Antigravity Core Template - Fast Pre-Commit Security Hook (<1.5s execution)
set -eo pipefail

PY_BIN="python3"
if command -v python3.13 >/dev/null 2>&1; then
  PY_BIN="python3.13"
elif command -v python3.12 >/dev/null 2>&1; then
  PY_BIN="python3.12"
fi

echo "==> [Antigravity Pre-Commit] Checking syntax & compilation..."
$PY_BIN -m compileall -q .

# Resolve TedRedCraft security engine (local clone or module)
REDCRAFT_DIR="/Users/ted/Development/TedRedCraft"
if $PY_BIN -m redcraft --help >/dev/null 2>&1; then
  echo "==> [RedCraft Tier 1] Running fast pre-commit SAST & staged secret scan..."
  $PY_BIN -m redcraft audit --mode pre-commit --target .
  echo "==> [RedCraft Tier 1] Security gate PASSED."
elif [[ -d "$REDCRAFT_DIR" && -f "$REDCRAFT_DIR/redcraft/cli.py" ]]; then
  echo "==> [RedCraft Tier 1] Running fast pre-commit SAST via $REDCRAFT_DIR..."
  PYTHONPATH="$REDCRAFT_DIR" $PY_BIN -m redcraft audit --mode pre-commit --target .
  echo "==> [RedCraft Tier 1] Security gate PASSED."
else
  echo "[i] TedRedCraft security engine not found locally."
  echo "    To enable automated Tier 1 SAST & DAST gates, clone the private repository:"
  echo "    git clone https://github.com/teddymwai/TedRedCraft /Users/ted/Development/TedRedCraft"
fi
